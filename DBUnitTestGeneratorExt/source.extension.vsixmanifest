<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="DBUnitTestGenExt-2002-a2f05c34-c236-4adf-a15c-0591ece88698" Version="1.3" Language="en-US" Publisher="Bert O'Neill" />
    <DisplayName>Auto Generate MSTests For SQL Server</DisplayName>
    <Description xml:space="preserve">Auto generate (C#) MSTests for your SQL Server database.
Create the scaffolding unit test code for each database object you select:
1) Stored Procedures (inc. output parameters)
2) Scalar Functions
3) Table\Inline Functions
4) Views
5) Computed Fields</Description>
    <Icon>Images\Icons\database-error-icon.png</Icon>
    <PreviewImage>Images\Icons\database-edit-icon.png</PreviewImage>
    <Tags>MSTest SQL Server</Tags>
  </Metadata>
  <Installation>
    <!--<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>-->
	  <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[15.0,17.0)">
		  <ProductArchitecture>x86</ProductArchitecture>
	  </InstallationTarget>
	  <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)">
		  <ProductArchitecture>amd64</ProductArchitecture>
	  </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0, 18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.ToolboxControl" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
