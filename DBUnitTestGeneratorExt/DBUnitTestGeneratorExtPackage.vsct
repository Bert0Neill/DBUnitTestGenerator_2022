  <!--Standard images\Moniker (http://glyphlist.azurewebsites.net/knownmonikers/) -->
  <Include href="KnownImageIds.vsct" />

  <!--This is the file that defines the IDs for all the commands exposed by VisualStudio. -->
  <Extern href="stdidcmd.h" />

  <!--This header contains the command ids for the menus provided by the shell. -->
  <Extern href="vsshlids.h" />

  <!--The Commands section is where commands, menus, and menu groups are defined.
      This section uses a Guid to identify the package that provides the command defined inside it. -->
  <Commands package="guidDBUnitTestGeneratorExtPackage">

    <Menus>
      <Menu guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="TopLevelMenu" priority="0x700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Test Menu</ButtonText>
          <CommandName>Database Unit Test Generator</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="TopLevelMenu" />
      </Group>
      <Group guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <!--Buttons section. -->    
    <Buttons>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="cmdPromptDatabaseId" priority="0x0100" type="Button">
        <Parent guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="MyMenuGroup" />        
        <Icon guid="ImageCatalogGuid" id="EditDatabase" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Configuration Panel</ButtonText>          
          <CommandName>CommandId</CommandName>
          <ToolTipText>Add or remove database objects to unit test</ToolTipText>
        </Strings>
      </Button>
       <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="cmdidToolWindow1Command" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages1" id="bmpPic1" />
        <Strings>
          <ButtonText>ToolWindow1</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="cmdidToolWindow1Command1" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages2" id="bmpPic1" />
        <Strings>
          <ButtonText>ToolWindow1</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet" id="cmdidToolWindow1Command2" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages3" id="bmpPic1" />
        <Strings>
          <ButtonText>ToolWindow1</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="cmdidcmdDB_Details" priority="0x0100" type="Button">
        <Parent guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="MyMenuGroup" />
        <Icon guid="guidImages4" id="bmpPic1" />
        <Strings>
          <ButtonText>Invoke cmdDB_Details</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="cmdidcmdDB_Objects" priority="0x0100" type="Button">
        <Parent guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="MyMenuGroup" />
        <Icon guid="guidImages5" id="bmpPic1" />
        <Strings>
          <ButtonText>Invoke cmdDB_Objects</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="cmdidcmdDB_UnitTests" priority="0x0100" type="Button">
        <Parent guid="guidDBUnitTestGeneratorExtPackageCmdSet1" id="MyMenuGroup" />
        <Icon guid="guidImages6" id="bmpPic1" />
        <Strings>
          <ButtonText>Invoke cmdDB_UnitTests</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <!--The bitmaps section is used to define the bitmaps that are used for the commands.-->
    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\cmdPromptDatabase.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />     
    </Bitmaps>
  </Commands>

